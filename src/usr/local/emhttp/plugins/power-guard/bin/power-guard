#!/usr/bin/php -q
<?php
declare(strict_types=1);

namespace PowerGuard;

require dirname(__DIR__) . '/lib/bootstrap.php';

const USAGE = <<<TXT
Usage: power-guard <command> [options]

  detect               Hardware-Erkennung als JSON
  plan [--profile=P]   Ist/Soll aller Tweaks (P: efficiency|balanced|performance)
  status               Kompletter Status (Hardware, Plan, Konflikte) als JSON
  conflicts            Konflikte mit anderen Plugins/Skripten
  telemetry            Eine Telemetrie-Stichprobe
  preview [--ids=a,b]  Geplante Änderungen (vorher → nachher)
  apply --ids=a,b|--all  Änderungen anwenden; die IDs werden ab dann verwaltet
  apply --boot         Verwaltete Tweaks erneut setzen (Boot/Array-Start)
  revert [--ids=a,b]   Auf die Baseline zurücksetzen (ohne IDs: alles, Modus „Beobachten“)
  journal              Änderungsprotokoll

Optionen: --pretty  formatiertes JSON   --table  Tabelle   --quiet  keine Ausgabe

TXT;

function out(mixed $data, bool $pretty): void
{
    echo json_encode($data, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | ($pretty ? JSON_PRETTY_PRINT : 0)), "\n";
}

function fmt(mixed $v, ?string $f): string
{
    if ($v === null) {
        return '–';
    }
    if (is_int($v) && $f === 'bytes') {
        return $v >= 1073741824 ? round($v / 1073741824, 1) . ' GiB' : round($v / 1048576) . ' MiB';
    }
    if (is_int($v) && $f === 'kib') {
        return round($v / 1024) . ' MiB';
    }
    if ($f === 'bool' && is_int($v)) {
        return $v ? 'an' : 'aus';
    }
    return is_scalar($v) ? (string)$v : json_encode($v);
}

$args = array_slice($argv, 1);
$cmd = $args[0] ?? 'help';
$opts = [];
foreach (array_slice($args, 1) as $a) {
    if (preg_match('/^--([a-z-]+)(?:=(.*))?$/', $a, $m)) {
        $opts[$m[1]] = $m[2] ?? true;
    }
}
$pretty = isset($opts['pretty']);

try {
    switch ($cmd) {
        case 'detect':
            out(Hardware::detect(), $pretty);
            break;
        case 'plan':
            $p = $opts['profile'] ?? null;
            if ($p !== null && !in_array($p, Registry::PROFILES, true)) {
                fwrite(STDERR, "Unbekanntes Profil: $p\n");
                exit(2);
            }
            $plan = Service::plan(is_string($p) ? $p : null);
            if (isset($opts['table'])) {
                printf("Profil: %s   Score: %d/100\n\n", $plan['profile'], $plan['score']['value']);
                foreach ($plan['rows'] as $r) {
                    $col = static fn(mixed $v): string => mb_str_pad(mb_strimwidth(fmt($v, $r['format']), 0, 28, '…'), 28);
                    printf("%-12s %-34s %s -> %s %s\n", $r['status'], $r['id'], $col($r['current']), $col($r['target']),
                        $r['reason'] ? '  ! ' . $r['reason'] : '');
                }
            } else {
                out($plan, $pretty);
            }
            break;
        case 'status':
            out(Service::status(), $pretty);
            break;
        case 'conflicts':
            out(Conflicts::scan(), $pretty);
            break;
        case 'telemetry':
            out(Telemetry::sample(), $pretty);
            break;
        case 'preview':
            $changes = Service::preview(Service::ids($opts['ids'] ?? null));
            if (isset($opts['table'])) {
                foreach ($changes as $c) {
                    printf("%-34s %s -> %s%s\n", $c['id'], fmt($c['from'], $c['format']), fmt($c['to'], $c['format']),
                        $c['supported'] ? ($c['error'] ? '  ! ' . $c['error'] : '') : '  (folgt in Phase 4)');
                    foreach ($c['writes'] as $w) {
                        printf("    %s = %s\n", $w['path'], $w['value']);
                    }
                }
            } else {
                out($changes, $pretty);
            }
            break;
        case 'apply':
            if (isset($opts['boot'])) {
                $res = Engine::apply(null, true);
            } else {
                $ids = isset($opts['all']) ? array_column(array_filter(Service::preview(), static fn($c) => $c['supported'] && !$c['error']), 'id')
                    : Service::ids($opts['ids'] ?? null);
                if (!$ids) {
                    fwrite(STDERR, "power-guard: --ids=… oder --all angeben (siehe 'power-guard preview').\n");
                    exit(2);
                }
                $res = Engine::apply($ids);
            }
            if (!isset($opts['quiet'])) {
                out($res, $pretty);
            }
            exit($res['failed'] ? 1 : 0);
        case 'revert':
            $res = Engine::revert(Service::ids($opts['ids'] ?? null));
            if (!isset($opts['quiet'])) {
                out($res, $pretty);
            }
            exit($res['failed'] ? 1 : 0);
        case 'journal':
            out(State::journalRead(200), $pretty);
            break;
        case 'help':
        case '--help':
        case '-h':
            echo USAGE;
            break;
        default:
            fwrite(STDERR, USAGE);
            exit(2);
    }
} catch (\Throwable $e) {
    fwrite(STDERR, 'power-guard: ' . $e->getMessage() . "\n");
    exit(1);
}
